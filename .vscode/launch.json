    "version": "0.2.0",
    "configurations": [
        {"type":"node","request":"launch","name":"Run nodemon","runtimeExecutable":"nodemon","cwd":"${workspaceFolder}","args":[]},

        {
          "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/backend/index.js"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}